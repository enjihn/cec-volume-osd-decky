{
  "name": "cec-volume-osd",
  "version": "1.0.0-rc.1",
  "description": "Read-only HDMI-CEC volume OSD for SteamOS and Bazzite Gaming Mode",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test:frontend": "tsc -p tsconfig.test.json && node --test test/*.test.mjs",
    "test:python": "PYTHONPATH=py_modules python3 -m unittest discover -s test -p 'test_*.py'",
    "test": "pnpm run test:python && pnpm run test:frontend && pnpm run typecheck"
  },
  "license": "MIT",
  "author": "enjihn",
  "repository": {
    "type": "git",
    "url": "https://github.com/enjihn/cec-volume-osd-decky.git"
  },
  "bugs": {
    "url": "https://github.com/enjihn/cec-volume-osd-decky/issues"
  },
  "homepage": "https://github.com/enjihn/cec-volume-osd-decky#readme",
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@decky/api": "1.1.3",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.11.6",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "happy-dom": "20.11.1",
    "rollup": "4.62.0",
    "typescript": "6.0.3"
  }
}
